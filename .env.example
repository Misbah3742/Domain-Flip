# Example environment variables for Domain-Flip
# Copy this file to .env and fill in real values before running.

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=domainflip
POSTGRES_USER=domainflip
POSTGRES_PASSWORD=changeme

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ── WhoisXML API ───────────────────────────────────────────────────────────────
# Get your key at: https://www.whoisxmlapi.com/
WHOISXML_API_KEY=your_whoisxml_api_key_here

# ── GoDaddy registrar ──────────────────────────────────────────────────────────
# Get your keys at: https://developer.godaddy.com/
GODADDY_API_KEY=your_godaddy_api_key_here
GODADDY_API_SECRET=your_godaddy_api_secret_here

# ── Dynadot registrar ──────────────────────────────────────────────────────────
# Get your key at: https://www.dynadot.com/domain/api2.html
DYNADOT_API_KEY=your_dynadot_api_key_here

# ── Namejet registrar ──────────────────────────────────────────────────────────
NAMEJET_API_KEY=your_namejet_api_key_here
NAMEJET_API_SECRET=your_namejet_api_secret_here

# ── Namecheap registrar ────────────────────────────────────────────────────────
# Get your key at: https://ap.www.namecheap.com/settings/tools/apiaccess/
# NAMECHEAP_CLIENT_IP must be whitelisted in the Namecheap API control panel.
NAMECHEAP_API_KEY=your_namecheap_api_key_here
NAMECHEAP_API_USER=your_namecheap_username_here
NAMECHEAP_CLIENT_IP=your_server_public_ip_here
# Registrant contact info required for domain registration via Namecheap
NAMECHEAP_REGISTRANT_FIRST_NAME=John
NAMECHEAP_REGISTRANT_LAST_NAME=Doe
NAMECHEAP_REGISTRANT_ADDRESS=123 Main St
NAMECHEAP_REGISTRANT_CITY=New York
NAMECHEAP_REGISTRANT_STATE=NY
NAMECHEAP_REGISTRANT_POSTAL_CODE=10001
NAMECHEAP_REGISTRANT_COUNTRY=US
NAMECHEAP_REGISTRANT_PHONE=+1.2125551234
NAMECHEAP_REGISTRANT_EMAIL=you@example.com

# ── Domain valuation API ───────────────────────────────────────────────────────
VALUATION_API_KEY=your_valuation_api_key_here

# ── Notifications ──────────────────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── Monitoring tuning ──────────────────────────────────────────────────────────
# Seconds between individual WHOIS checks (rate-limiting)
MONITOR_CHECK_INTERVAL_SECONDS=30
# Maximum concurrent checker threads
MONITOR_MAX_WORKERS=10

# ── Sniper timing ──────────────────────────────────────────────────────────────
# How many seconds before predicted drop time to start polling
SNIPER_LEAD_TIME_SECONDS=120
# Polling interval during the final countdown (milliseconds)
SNIPER_POLL_INTERVAL_MS=500
# Enable local simulation mode; no registrar API keys required
SNIPER_DRY_RUN=false
