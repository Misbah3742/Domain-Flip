# Example environment variables for Domain-Flip
# Copy this file to .env and fill in real values before running.

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=domainflip
POSTGRES_USER=domainflip
POSTGRES_PASSWORD=changeme

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ── WhoisXML API ───────────────────────────────────────────────────────────────
WHOISXML_API_KEY=your_whoisxml_api_key_here

# ── Dynadot registrar ──────────────────────────────────────────────────────────
DYNADOT_API_KEY=your_dynadot_api_key_here

# ── Namejet registrar ──────────────────────────────────────────────────────────
NAMEJET_API_KEY=your_namejet_api_key_here
NAMEJET_API_SECRET=your_namejet_api_secret_here

# ── Monitoring tuning ──────────────────────────────────────────────────────────
# Seconds between individual WHOIS checks (rate-limiting)
MONITOR_CHECK_INTERVAL_SECONDS=30
# Maximum concurrent checker threads
MONITOR_MAX_WORKERS=10

# ── Sniper timing ──────────────────────────────────────────────────────────────
# How many seconds before predicted drop time to start polling
SNIPER_LEAD_TIME_SECONDS=120
# Polling interval during the final countdown (milliseconds)
SNIPER_POLL_INTERVAL_MS=500
# Enable local simulation mode; no registrar API keys required
SNIPER_DRY_RUN=false
